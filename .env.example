# Copy to .env and fill in. NEVER commit .env. NEVER paste real values into chat.
# All values below are placeholders.

# ---- Supabase (local or staging only; NEVER production in a dev .env) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=REPLACE_ME_anon_key_is_public_by_design_RLS_is_the_protection
# Service-role key: backend only. Never in client code, never in FlutterFlow.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_backend_only

# ---- Environment ----
APP_ENV=local           # local | staging | production
LOG_LEVEL=info

# ---- AI / ASR providers ----
# NOT SELECTED. Blocked on WS-4 (PDPL/residency + contractual data-use review).
# Until then the orchestrator runs against fixtures only.
ASR_PROVIDER=fixture
ASR_API_KEY=

# ---- Audio retention ----
# Retention period for review-flagged audio is TBD pending the PDPL review (D7).
# It MUST remain configurable. Default behaviour is process-and-discard.
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=
